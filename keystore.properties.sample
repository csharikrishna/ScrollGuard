# Copy this file to keystore.properties (git-ignored) for local release builds, or set the
# equivalent SCROLLGUARD_RELEASE_* environment variables instead (what CI should use).
# See README.md's "Release Signing" section for how to generate a keystore.

storeFile=/absolute/path/to/scrollguard-release.jks
storePassword=changeit
keyAlias=scrollguard
keyPassword=changeit
