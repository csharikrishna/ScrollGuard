<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Special/protected permission: cannot be granted via the manifest. The user grants it
         explicitly through Settings.ACTION_USAGE_ACCESS_SETTINGS (see AppPickerActivity). This
         is the documented pattern for apps that need optional usage-access data. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- firebase-analytics-ktx (pulled in directly, and transitively by Crashlytics) merges in
         both of these permissions automatically regardless of the
         google_analytics_adid_collection_enabled=false meta-data below — that flag only stops
         the SDK from reading/attaching the advertising ID at runtime, it does not remove the
         permission declaration itself. ScrollGuard has no advertising use case (this app handles
         child usage data, where an undeclared/unused ad-ID capability is a real Play Store
         Data Safety and child-safety-policy liability, not just unnecessary), so both are
         explicitly stripped from the merged manifest — the documented way to opt out per
         Firebase's own guidance for apps using Analytics/Crashlytics without ads. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Package-visibility scope for the app picker: only launchable (user-facing) apps need to
         be selectable as block targets, so this is deliberately narrower than QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- allowBackup=false disables cloud backup AND device-to-device transfer completely on
         every API level, which is the actual intent here (session/lock state and monitored
         apps are device-specific and would be confusing to silently restore onto a new device
         or after a reinstall). android:dataExtractionRules is a finer-grained alternative for
         apps that want backup with per-file control — not needed when the goal is simply "no
         backup at all", so the lint suggestion doesn't apply here. -->
    <application
        android:allowBackup="false"
        tools:ignore="DataExtractionRules"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScrollGuard">

        <!-- Firebase Analytics is pulled in transitively by Crashlytics (a dependency of the
             crash-reporting SDK), but no product justification for actually collecting general
             usage-analytics events was ever identified for this app — least of all one that
             handles child data. Disabling collection entirely (not just the ad-ID) is the
             minimum-necessary-access choice; Crashlytics's own crash/session data is unaffected,
             since it doesn't depend on Analytics collection being active. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupGuideActivity"
            android:exported="false"
            android:label="Get ScrollGuard Ready"
            android:theme="@style/Theme.ScrollGuard" />

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:label="Select Apps"
            android:theme="@style/Theme.ScrollGuard" />

        <activity
            android:name=".UsageStatsActivity"
            android:exported="false"
            android:label="Analytics"
            android:theme="@style/Theme.ScrollGuard" />

        <activity
            android:name=".BlockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:theme="@style/Theme.ScrollGuard.Block" />

        <activity
            android:name=".PinActivity"
            android:resizeableActivity="false"
            android:exported="false" />

        <activity
            android:name=".ParentalControlActivity"
            android:exported="false"
            android:label="@string/parental_control"
            android:theme="@style/Theme.ScrollGuard" />

        <activity
            android:name=".ParentalAppPickerActivity"
            android:exported="false"
            android:label="@string/select_apps_to_restrict"
            android:theme="@style/Theme.ScrollGuard" />

        <activity
            android:name=".AppGroupsActivity"
            android:exported="false"
            android:label="@string/app_groups"
            android:theme="@style/Theme.ScrollGuard" />

        <service
            android:name=".TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="App usage timer and blocker" />
        </service>

        <service
            android:name=".BlockerAccessibilityService"
            android:exported="true"
            android:label="ScrollGuard Blocker"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Fires when this app's own APK is updated/reinstalled — unlike
                     BOOT_COMPLETED, this is the only signal that a foreground service the OS
                     just killed for the update (TimerService) needs restarting. Without this,
                     an in-place update during an active session left TimerService dead with no
                     automatic recovery (see docs/audits/reports/UI_AUDIT_PROGRESS.md Part 2, finding #1). -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".AdminReceiver"
            android:label="ScrollGuard Strict Mode"
            android:description="@string/admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_rules" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
