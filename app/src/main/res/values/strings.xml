    <!-- Setup Guide -->
    <string name="setup_guide_title">Get ScrollGuard Ready</string>
    <string name="setup_guide_intro">ScrollGuard blocks distracting apps on a timer you control: usable for a while, then locked, on repeat. To do that reliably, it needs a few permissions from your phone — here\'s exactly what and why.</string>
    <string name="setup_step_apps_title">Choose apps to restrict</string>
    <string name="setup_step_apps_why">Pick which apps ScrollGuard should block once your locked time begins. You can change this anytime.</string>
    <string name="setup_step_accessibility_title">Accessibility access</string>
    <string name="setup_step_accessibility_short">Needed so ScrollGuard can detect when you open a restricted app.</string>
    <string name="setup_step_accessibility_why">This is what lets ScrollGuard notice when you open a restricted app so it can block it. Without it, ScrollGuard can\'t detect app launches at all.\n\nTap \"Open Settings\", find \"ScrollGuard Blocker\" in the list, and turn it on. Then come back here — we\'ll check automatically.\n\nIf you see \"Restricted Setting\" instead of a switch: open ScrollGuard\'s App Info, tap the three dots in the top right, choose \"Allow restricted settings\", then try again.\n\nIf it\'s already on but not working, try turning it off and back on again.</string>
    <string name="setup_continue_without_accessibility_warning">Accessibility access isn\'t on yet, so ScrollGuard can\'t detect or block restricted apps. Continue anyway?</string>
    <string name="setup_continue_anyway">Continue Anyway</string>
    <string name="setup_step_overlay_title">Display over other apps</string>
    <string name="setup_step_overlay_why">The lock screen ScrollGuard shows has to appear on top of the app you\'re trying to use — this permission is what allows that.\n\nTap \"Open Settings\" and turn the switch on for ScrollGuard, then come back here.</string>
    <string name="setup_step_battery_title">Ignore battery optimization</string>
    <string name="setup_step_battery_why">Android aggressively pauses background apps to save power, which can stop ScrollGuard\'s timer from running while your screen is off. Exempting ScrollGuard keeps it working reliably.\n\nTap \"Open Settings\" and allow ScrollGuard to run in the background, then come back here.</string>
    <string name="setup_step_notifications_title">Notifications</string>
    <string name="setup_step_notifications_why">ScrollGuard shows an ongoing notification with your remaining time, and will alert you if blocking ever stops working. Tap \"Allow\" on the prompt.</string>
