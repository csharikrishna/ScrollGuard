<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_guide_title"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_guide_intro"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <!-- Row: Choose apps -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ScrollGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvAppsCheck"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:textSize="18sp"
                            android:textColor="@color/text_muted"
                            tools:text="○" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_step_apps_title"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginStart="8dp" />
                        <ImageButton
                            android:id="@+id/btnAppsInfo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_info_details"
                            app:tint="@color/text_secondary"
                            android:contentDescription="@string/cd_info" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvAppsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginStart="36dp"
                        android:layout_marginTop="2dp"
                        tools:text="@string/setup_step_action_needed" />
                    <Button
                        android:id="@+id/btnAppsAction"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/choose_apps"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/text_primary"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Row: Accessibility -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ScrollGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvAccessibilityCheck"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:textSize="18sp"
                            android:textColor="@color/text_muted"
                            tools:text="○" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_step_accessibility_title"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginStart="8dp" />
                        <ImageButton
                            android:id="@+id/btnAccessibilityInfo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_info_details"
                            app:tint="@color/text_secondary"
                            android:contentDescription="@string/cd_info" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvAccessibilityStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginStart="36dp"
                        android:layout_marginTop="2dp"
                        tools:text="@string/setup_step_action_needed" />
                    <Button
                        android:id="@+id/btnAccessibilityAction"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_step_open_settings"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/text_primary"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Row: Overlay -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ScrollGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvOverlayCheck"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:textSize="18sp"
                            android:textColor="@color/text_muted"
                            tools:text="○" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_step_overlay_title"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginStart="8dp" />
                        <ImageButton
                            android:id="@+id/btnOverlayInfo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_info_details"
                            app:tint="@color/text_secondary"
                            android:contentDescription="@string/cd_info" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvOverlayStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginStart="36dp"
                        android:layout_marginTop="2dp"
                        tools:text="@string/setup_step_action_needed" />
                    <Button
                        android:id="@+id/btnOverlayAction"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_step_open_settings"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/text_primary"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Row: Battery -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ScrollGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvBatteryCheck"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:textSize="18sp"
                            android:textColor="@color/text_muted"
                            tools:text="○" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_step_battery_title"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginStart="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_guide_recommended_label"
                            android:textColor="@color/warning"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />
                        <ImageButton
                            android:id="@+id/btnBatteryInfo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_info_details"
                            app:tint="@color/text_secondary"
                            android:contentDescription="@string/cd_info" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvBatteryStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginStart="36dp"
                        android:layout_marginTop="2dp"
                        tools:text="@string/setup_step_action_needed" />
                    <Button
                        android:id="@+id/btnBatteryAction"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_step_open_settings"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/text_primary"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Row: Xiaomi/HyperOS Autostart — visibility set at runtime, Xiaomi-family devices
                 only. Android has no public API to read this OEM-private setting's current
                 state, so unlike the other rows this one can never show a real ✓ — it's an
                 acknowledge-once nudge, not a verified check. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardXiaomiAutostart"
                style="@style/ScrollGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvXiaomiAutostartCheck"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:textSize="18sp"
                            android:textColor="@color/text_muted"
                            tools:text="○" />
                        <TextView
                            android:id="@+id/tvXiaomiAutostartTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_step_xiaomi_autostart_title"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginStart="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_guide_recommended_label"
                            android:textColor="@color/warning"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />
                        <ImageButton
                            android:id="@+id/btnXiaomiAutostartInfo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_info_details"
                            app:tint="@color/text_secondary"
                            android:contentDescription="@string/cd_info" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvXiaomiAutostartStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginStart="36dp"
                        android:layout_marginTop="2dp"
                        tools:text="@string/setup_step_action_needed" />
                    <Button
                        android:id="@+id/btnXiaomiAutostartAction"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_step_open_settings"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/text_primary"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Row: Notifications (Android 13+ only, visibility set at runtime) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotifications"
                style="@style/ScrollGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvNotificationsCheck"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:textSize="18sp"
                            android:textColor="@color/text_muted"
                            tools:text="○" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_step_notifications_title"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginStart="8dp" />
                        <ImageButton
                            android:id="@+id/btnNotificationsInfo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_info_details"
                            app:tint="@color/text_secondary"
                            android:contentDescription="@string/cd_info" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvNotificationsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginStart="36dp"
                        android:layout_marginTop="2dp"
                        tools:text="@string/setup_step_action_needed" />
                    <Button
                        android:id="@+id/btnNotificationsAction"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_step_allow"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/text_primary"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvAllDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_guide_all_done"
                android:textColor="@color/success"
                android:textStyle="bold"
                android:gravity="center"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnContinue"
                style="@style/ScrollGuard.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/setup_guide_continue"
                android:textSize="15sp"
                android:backgroundTint="@color/primary"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
