<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieLock"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:lottie_rawRes="@raw/lottie_lock"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/admin_access"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/primary"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"
        tools:text="Solve to unlock: 247 + 318"/>

    <TextView
        android:id="@+id/tvDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/primary"
        android:textSize="32sp"
        android:layout_marginBottom="16dp"
        tools:text="○  ○  ○" />

    <TextView
        android:id="@+id/tvCooldown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/error"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        tools:text="Too many wrong answers — try again in 3s"
        tools:visibility="visible" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4">

        <Button style="@style/PinButton" android:id="@+id/btn1" android:text="@string/pin_digit_1" />
        <Button style="@style/PinButton" android:id="@+id/btn2" android:text="@string/pin_digit_2" />
        <Button style="@style/PinButton" android:id="@+id/btn3" android:text="@string/pin_digit_3" />
        <Button style="@style/PinButton" android:id="@+id/btn4" android:text="@string/pin_digit_4" />
        <Button style="@style/PinButton" android:id="@+id/btn5" android:text="@string/pin_digit_5" />
        <Button style="@style/PinButton" android:id="@+id/btn6" android:text="@string/pin_digit_6" />
        <Button style="@style/PinButton" android:id="@+id/btn7" android:text="@string/pin_digit_7" />
        <Button style="@style/PinButton" android:id="@+id/btn8" android:text="@string/pin_digit_8" />
        <Button style="@style/PinButton" android:id="@+id/btn9" android:text="@string/pin_digit_9" />
        <Button style="@style/PinButton" android:id="@+id/btnCancel" android:text="@string/pin_cancel_symbol"
            android:contentDescription="@string/cd_pin_cancel" />
        <Button style="@style/PinButton" android:id="@+id/btn0" android:text="@string/pin_digit_0" />
        <Button style="@style/PinButton" android:id="@+id/btnDel" android:text="@string/pin_delete_symbol"
            android:contentDescription="@string/cd_pin_delete" />

    </GridLayout>

</LinearLayout>
</androidx.core.widget.NestedScrollView>
