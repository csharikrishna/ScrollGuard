local.properties

# Gradle
.gradle/
build/

# IDE
.idea/
*.iml
*.iws

# local build
app/build/

# Release signing secrets — never commit these
keystore.properties
*.jks
*.keystore

# Firebase client config is project-specific (not a secret per se — the real security
# boundary is Firestore Rules + Auth + App Check — but it's environment-specific like the
# signing config above, so it follows the same local-file + committed-sample convention).
# See app/google-services.json.sample.
app/google-services.json

# Personal editor settings
.vscode/

# Firebase emulator debug log (generated by `firebase emulators:exec`/`:start`)
firestore-debug.log

# Firebase CLI's local deploy cache (generated by `firebase deploy`)
.firebase/

# Claude Code / Firebase agent-skills cache — fetched tooling docs, not app source or
# authored content. Re-fetchable from firebase/agent-skills; nothing here is project-specific.
.agents/
skills-lock.json

# Ad-hoc screenshots and uiautomator UI dumps some sessions have saved straight into the repo
# root while testing on an emulator — these belong in a scratch dir, never in git history.
/*.png
/*.jpg
/c_*.xml
/ui_dump*.xml

